#!/usr/bin/env bash
# notify "<message>" [options]   (run `notify --help` for the options)
# Sends a macOS notification that stays in Notification Center, plays a sound and,
# unless turned off, shows a floating dialog. Defaults come from the config file.
set -uo pipefail

CONFIG="${CLAUDE_NOTIFY_CONFIG:-$HOME/.config/claude-notify/config}"
# Defaults (the config file can override any of them).
TITLE="Claude Code"
IMAGE=""
SOUND="Glass"            # a name from /System/Library/Sounds, or "none"
DIALOG="on"              # on | off
DIALOG_SECONDS=8         # dialog closes itself after this many seconds
NOTIFICATION="on"        # on | off
APP="$HOME/Applications/ClaudeNotify.app"
# shellcheck disable=SC1090
[[ -f "$CONFIG" ]] && source "$CONFIG"

usage() {
  cat <<'HELP'
Usage: notify "<message>" [options]

Plays a sound, posts a notification that stays in Notification Center and shows a
floating dialog that closes itself. Defaults come from ~/.config/claude-notify/config.

Options:
  --title T        title of the notification and the dialog
  --subtitle S     subtitle, e.g. the project name
  --image PATH     image (png/jpg/icns) for this notification; "" for none
  --sound NAME     a sound from /System/Library/Sounds (Glass, Ping, Hero...) or none
  --seconds N      seconds before the dialog closes itself
  --no-dialog      skip the floating dialog
  --no-sound       play no sound
  -h, --help       show this help
HELP
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
MESSAGE="${1:-Done}"; shift || true
SUBTITLE=""
need() { [[ $# -ge 2 ]] || { echo "notify: $1 needs a value" >&2; exit 64; }; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --title) need "$@"; TITLE="$2"; shift 2 ;;
    --subtitle) need "$@"; SUBTITLE="$2"; shift 2 ;;
    --image) need "$@"; IMAGE="$2"; shift 2 ;;
    --sound) need "$@"; SOUND="$2"; shift 2 ;;
    --seconds) need "$@"; DIALOG_SECONDS="$2"; shift 2 ;;
    --no-dialog) DIALOG="off"; shift ;;
    --no-sound) SOUND="none"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "notify: unknown option $1 (see notify --help)" >&2; exit 64 ;;
  esac
done
[[ "$DIALOG_SECONDS" =~ ^[0-9]+$ ]] || DIALOG_SECONDS=8
IMAGE="${IMAGE/#\~/$HOME}"

# Escape for an AppleScript string literal.
as_str() { local s="${1//\\/\\\\}"; printf '"%s"' "${s//\"/\\\"}"; }

play_here() {
  [[ "$SOUND" != "none" && -f "/System/Library/Sounds/$SOUND.aiff" ]] && (afplay "/System/Library/Sounds/$SOUND.aiff" &)
}

if [[ "$NOTIFICATION" == "on" ]]; then
  if [[ -d "$APP" ]]; then
    # The notification plays the sound itself, so it rings with the banner.
    snd="none"; [[ "$SOUND" != "none" ]] && snd="$SOUND.aiff"
    args=(--title "$TITLE" --message "$MESSAGE" --sound "$snd")
    [[ -n "$SUBTITLE" ]] && args+=(--subtitle "$SUBTITLE")
    [[ -n "$IMAGE" && -f "$IMAGE" ]] && args+=(--image "$IMAGE")
    open -g "$APP" --args "${args[@]}"
  else
    # Fallback: shows only if Script Editor is allowed in System Settings > Notifications.
    play_here
    osascript -e "display notification $(as_str "$MESSAGE") with title $(as_str "$TITLE") subtitle $(as_str "$SUBTITLE")" >/dev/null 2>&1
  fi
else
  play_here
fi

if [[ "$DIALOG" == "on" ]]; then
  # Same picture as the notification: the image, else the app icon. "note" is the
  # last resort because osascript has no icon of its own and macOS shows a folder.
  app_icon="$APP/Contents/Resources/AppIcon.icns"
  icon="with icon note"
  if [[ -n "$IMAGE" && -f "$IMAGE" ]]; then
    icon="with icon (POSIX file $(as_str "$IMAGE"))"
  elif [[ -f "$app_icon" ]]; then
    icon="with icon (POSIX file $(as_str "$app_icon"))"
  fi
  dtitle="$TITLE"; [[ -n "$SUBTITLE" ]] && dtitle="$TITLE · $SUBTITLE"
  (osascript -e "display dialog $(as_str "$MESSAGE") with title $(as_str "$dtitle") buttons {\"OK\"} default button \"OK\" $icon giving up after $DIALOG_SECONDS" >/dev/null 2>&1 &)
fi
exit 0
